{
  "name": "bw-modeling-mcp",
  "version": "2.0.0",
  "description": "Read-only MCP server for SAP BW queries released as OData services",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bw-modeling-mcp": "dist/stdio.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "sap",
    "bw",
    "bw4hana",
    "mcp",
    "model-context-protocol",
    "odata",
    "btp"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/stdio.js",
    "dev": "tsc && node dist/stdio.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arc-mcp/xsuaa-auth": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^4.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnic-dev/bw-modeling-mcp.git"
  },
  "author": "David Nicolay",
  "license": "MIT"
}
